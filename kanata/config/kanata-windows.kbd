;; Windows Kanata configuration. Portable layers only; no Linux device options.

(defsrc
  tab    q     w     e     r     t        y     u     i     o     p     [     ]     \
  caps   a     s     d     f     g        h     j     k     l     ;     '           ret
  lsft   z     x     c     v     b        n     m     ,     .     /                 rsft
  lctl         lmet        lalt           spc               ralt        rmet        rctl
)

(include "kanata-common.kbd")

(defalias
  cmod3 rctl
  shot M-S-s
)
