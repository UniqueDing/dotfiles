CONFIG_PATH=~/.config/zsh

if [[ "$(uname -s)" == Darwin ]]; then
  if [[ -r /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh ]]; then
    source /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
  fi

  if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  fi
elif [[ -r /home/uniqueding/.nix-profile/etc/profile.d/nix.sh ]]; then
  source /home/uniqueding/.nix-profile/etc/profile.d/nix.sh
fi

source $CONFIG_PATH/init.zsh

# Prefer the Home Manager package rather than the standalone curl installation.
path=("${(@)path:#$HOME/.opencode/bin}")
if [[ -x "$HOME/.nix-profile/bin/opencode" ]]; then
  path=("$HOME/.nix-profile/bin" $path)
fi
typeset -U path
