;; Linux Kanata configuration.
(include "kanata-common.kbd")
;; +-------+-------+-------+-------+-------+-------+--+-------+-------+-------+-------+-------+-------+-------+-------+
;; | @tnav |   q   |   w   | e   f | r   p | t   g |  | y   u | u   l | i   u | o   y | p   ; |   [   |   ]   |   \   |
;; |       | 1   ! | 2   @ | 3   # | 4   $ | 5   % |  |       |       |       |       |       |       |       |       |
;; |  tab  |       | prnt  | home  |  end  |       |  |       | pgdn  | pgup  |       |       |       |       |       |
;; +-------+-------+-------+-------+-------+-------+--+-------+-------+-------+-------+-------+-------+-------+-------+
;; | @cap  |   a   | s   r | d   s | f   t | g   d |  |   h   | j   n | k   e | l   i | ;   o |   '   |       |       |
;; | bspc  | 6   [ | 7   ] | 8   { | 9   } | 0   | |  |       | =   ( | -   ) | +     | *     | /     |       |  ret  |
;; | caps  |       |       |  del  | bspc  |       |  | left  | down  |  up   | right |       |       |       |       |
;; +-------+-------+-------+-------+-------+-------+--+-------+-------+-------+-------+-------+-------+-------+-------+
;; | @tcn  |   z   |   x   |   c   |   v   |   b   |  | n   k |   m   |   ,   |   .   |   ?   |       |       |  @jp  |
;; |       |     \ | x   & | _   ` | .   ~ |     ^ |  |       |       |       |       |       |       |       |       |
;; | lsft  |       |       |       |       |       |  |       |       |       |       |       |       |       | rsft  |
;; +-------+-------+-------+-------+-------+-------+--+-------+-------+-------+-------+-------+-------+-------+-------+
;; | lctl  |       | lmet  |       | lalt  |       |  |  spc  |       |       | ralt  |       | rmet  |       | @tmux |
;; +-------+-------+-------+-------+-------+-------+--+-------+-------+-------+-------+-------+-------+-------+-------+

(defcfg
  linux-dev-names-include ("uniqueding-kb Keyboard")
  linux-output-device-name "kanata"
  linux-continue-if-no-devs-found yes
)

(defsrc
  tab    q     w     e     r     t        y     u     i     o     p     [     ]     \
  caps   a     s     d     f     g        h     j     k     l     ;     '           ret
  lsft   z     x     c     v     b        n     m     ,     .     /                 rsft
  lctl         lmet        lalt           spc               ralt        rmet        rctl
)

(deflayer colemak
  @tnav  q     w     f     p     g        j     l     u     y     @temoji [     ]     \
  @cap   a     r     s     t     d        h     n     e     i     o     @tsym       ret
  lsft   z     x     c     v     b        k     m     ,     .     @tlatin           rsft
  lctl         @lmet-tmux  rctl           spc               @tnum       ralt        @tnum
)

(deflayer qwerty
  @tnav  q     w     e     r     t        y     u     i     o     p     [     ]     \
  @cap   a     s     d     f     g        h     j     k     l     ;     @tsym       ret
  @ten   z     x     c     v     b        n     m     ,     .     /                 @ten
  lctl         @lmet-tmux  rctl           spc               @tnum       ralt        rctl
)

(deflayer nav
  ;; Physical N takes the platform screenshot action; W remains unmapped.
  tab    XX    XX    home  end   XX       XX    pgdn  pgup  XX    XX    XX    XX    XX
  caps   XX    XX    del   bspc  XX       left  down  up    right XX    XX          ret
  lsft   XX    XX    XX    XX    XX       @platform-screenshot XX XX XX XX          rsft
  lctl         @lmet-tmux  rctl           spc               @tnum       ralt        rctl
)

(deflayer number
  tab    1     2     3     4     5        XX    XX    XX    XX    XX    XX    XX    XX
  bspc   6     7     8     9     0        XX    =     -     S-=   S-8   /           ret
  lsft   XX    x     S--   .     XX       XX    @tmux XX    XX    XX                rsft
  lctl         @lmet-tmux  rctl           spc               @tnum       ralt        rctl
)

;; The physical left Win (defsrc lmet) tap emits the completed tmux prefix and
;; arms this layer for the next key only. Its hold action is lalt. Letter
;; outputs below are the existing Colemak outputs at each physical position;
;; number positions therefore remain positional.
(deflayer tmux-command
  tab    1     2     3     4     5        M-j   M-l   M-u   M-y   M-;   [     ]     \
  esc    6     7     8     9     0        M-h   M-n   M-e   M-i   M-o   '           ret
  lsft   M-z   M-x   M-c   M-v   M-b      M-k   M-m   ,     .     /                 rsft
  lctl         lalt        lalt           spc               ralt        rmet        rctl
)

(defvirtualkeys
    tmux-command-once (one-shot-press 1200 (layer-while-held tmux-command))
)

(defalias
    lnav (layer-while-held nav)
    lsym (layer-while-held symbol)
    lnum (layer-while-held number)
    lemoji (layer-while-held emoji)
    llatin (layer-while-held latin)
    lqwe (layer-while-held qwerty)
    sqwe (layer-switch qwerty)
    scol (layer-switch colemak)

    esc (multi esc lctl lsft f1)

    lmet-tmux (tap-hold-press 200 200 (macro C-g (on-press tap-vkey tmux-command-once)) lalt)

    tnav (tap-hold-press 200 200 tab @lnav)
    tsym (tap-hold-press 200 200 ' @lsym)
    tnum (tap-hold-press 200 200 bspc @lnum)
    temoji (tap-hold-press 200 200 ; @lemoji)
    tlatin (tap-hold-press 200 200 / @llatin)
    ten (tap-hold-press 200 200 (multi lctl lsft f1 @scol) lsft)
    tcn (tap-hold-press 200 200 (multi lctl lsft f2 @sqwe) lsft)
    tjp (tap-hold-press 200 200 (multi lctl lsft f3 @sqwe) lsft)
    tmux (tap-hold-release 200 200 rctl C-g)

    cap (tap-hold-press 200 200 esc lctl)

    cmod1 lctl
    cmod2 @lmet-tmux
    cmod3 rctl
    cmod4 @tnum
    cmod5 ralt
    cmod6 @tnum
    platform-screenshot prnt

    emojia (macro (clipboard-save 0) 100 (clipboard-set "😀") 100 C-v 100 (clipboard-restore 0)) emojis (macro (clipboard-save 0) 100 (clipboard-set "😂") 100 C-v 100 (clipboard-restore 0)) emojih (macro (clipboard-save 0) 100 (clipboard-set "😭") 100 C-v 100 (clipboard-restore 0)) emojiz (macro (clipboard-save 0) 100 (clipboard-set "😴") 100 C-v 100 (clipboard-restore 0)) emojin (macro (clipboard-save 0) 100 (clipboard-set "🤔") 100 C-v 100 (clipboard-restore 0)) emojiu (macro (clipboard-save 0) 100 (clipboard-set "😎") 100 C-v 100 (clipboard-restore 0)) emojit (macro (clipboard-save 0) 100 (clipboard-set "🌝") 100 C-v 100 (clipboard-restore 0)) emojiy (macro (clipboard-save 0) 100 (clipboard-set "🌚") 100 C-v 100 (clipboard-restore 0)) emojij (macro (clipboard-save 0) 100 (clipboard-set "👀") 100 C-v 100 (clipboard-restore 0)) emojid (macro (clipboard-save 0) 100 (clipboard-set "❤️") 100 C-v 100 (clipboard-restore 0))
    emojil (macro (clipboard-save 0) 100 (clipboard-set "✅") 100 C-v 100 (clipboard-restore 0)) emojix (macro (clipboard-save 0) 100 (clipboard-set "❌") 100 C-v 100 (clipboard-restore 0)) emojiq (macro (clipboard-save 0) 100 (clipboard-set "❓") 100 C-v 100 (clipboard-restore 0)) emojiw (macro (clipboard-save 0) 100 (clipboard-set "⚠️") 100 C-v 100 (clipboard-restore 0)) emojip (macro (clipboard-save 0) 100 (clipboard-set "🎉") 100 C-v 100 (clipboard-restore 0)) emojie (macro (clipboard-save 0) 100 (clipboard-set "✨") 100 C-v 100 (clipboard-restore 0)) emojir (macro (clipboard-save 0) 100 (clipboard-set "🚀") 100 C-v 100 (clipboard-restore 0)) emojik (macro (clipboard-save 0) 100 (clipboard-set "🔥") 100 C-v 100 (clipboard-restore 0)) emojii (macro (clipboard-save 0) 100 (clipboard-set "💡") 100 C-v 100 (clipboard-restore 0))
    emojio (macro (clipboard-save 0) 100 (clipboard-set "👌") 100 C-v 100 (clipboard-restore 0)) emojic (macro (clipboard-save 0) 100 (clipboard-set "👏") 100 C-v 100 (clipboard-restore 0)) emojiv (macro (clipboard-save 0) 100 (clipboard-set "✌️") 100 C-v 100 (clipboard-restore 0)) emojib (macro (clipboard-save 0) 100 (clipboard-set "🤝") 100 C-v 100 (clipboard-restore 0)) emojif (macro (clipboard-save 0) 100 (clipboard-set "👍") 100 C-v 100 (clipboard-restore 0)) emojim (macro (clipboard-save 0) 100 (clipboard-set "🙏") 100 C-v 100 (clipboard-restore 0)) emojig (macro (clipboard-save 0) 100 (clipboard-set "🎈") 100 C-v 100 (clipboard-restore 0))

    cw (caps-word 2000)
)
