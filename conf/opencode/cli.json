{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system"
  },
  "keybinds": {
    "leader": "ctrl+x",
    "command.palette.show": "alt+p",
    "session.new": "alt+k",
    "session.page.up": "alt+e",
    "session.page.down": "alt+n",
    "input.visual.line.end": "alt+o",
    "session.tab.next": "alt+i",
    "session.tab.previous": "alt+h",
    "input.newline": "shift+return",
    "prompt.paste": "ctrl+v",
    "prompt.history.previous": [
      "up",
      "ctrl+p"
    ],
    "prompt.history.next": [
      "down",
      "ctrl+n"
    ]
  },
  "plugins": [
    "oh-my-opencode-slim",
    "@mohak34/opencode-notifier@0.8.2"
  ],
  "diffs": {
    "source": "working",
    "wrap": "word"
  },
  "terminal": {
    "title": true
  },
  "prompt": {
    "image_preview": true
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide",
    "image_preview": true
  },
  "animations": true
}
