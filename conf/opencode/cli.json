{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin"
  },
  "keybinds": {
    "leader": "ctrl+b",
    "command.palette.show": "ctrl+x",
    "session.page.up": "ctrl+u",
    "session.page.down": "ctrl+d",
    "prompt.paste": "ctrl+v",
    "prompt.history.previous": [
      "up",
      "ctrl+p"
    ],
    "prompt.history.next": [
      "down",
      "ctrl+n"
    ]
  },
  "plugins": [
    "oh-my-openagent@4.19.2",
    "oh-my-opencode-slim",
    "@mohak34/opencode-notifier@0.8.2"
  ],
  "diffs": {
    "wrap": "word"
  },
  "terminal": {
    "title": true
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide"
  },
  "animations": true
}
