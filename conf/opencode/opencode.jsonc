{
  "$schema": "https://opencode.ai/config.json",
  "experimental": {
    "todo": true
  },
  "plugins": [
    "oh-my-opencode-slim",
    "@mohak34/opencode-notifier@0.8.2"
  ],
  "providers": {
    "zhipuai-coding-plan": {
      "settings": {
        "baseURL": "https://open.bigmodel.cn/api/coding/paas/v4",
        "apiKey": "{env:ZHIPU_API_KEY}"
      }
    },
    "gemini": {
      "name": "Gemini Gateway",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "{env:OPENAI_API_BASE}",
        "apiKey": "{env:OPENAI_API_KEY}"
      },
      "models": {
        "gemini-4-argon-high": {
          "name": "Gemini 4 Argon High"
        },
        "gemini-3.8-flash-high": {
          "name": "Gemini 3.8 Flash High"
        },
        "gemini-3-flash": {
          "name": "Gemini 3 Flash"
        }
      }
    },
    "openai": {
      "package": "aisdk:@ai-sdk/openai",
      "settings": {
        "baseURL": "{env:OPENAI_API_BASE}",
        "apiKey": "{env:OPENAI_API_KEY}"

      }
    }
  },
  "lsp": true,
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**", "**/build*/**"]
  },
  "mcp": {
    "servers": {
      "codegraph": {
        "type": "local",
        "command": [
          "codegraph",
          "serve",
          "--mcp"
        ],
        "disabled": false
      },
      "computeruse": {
        "type": "local",
        "command": [
          "bash",
          "{env:HOME}/.config/opencode/scripts/computer-use-linux.sh"
        ],
        "disabled": false
      },
      "firefox": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@mozilla/firefox-devtools-mcp@0.10.5",
          "--connect-existing",
          "--marionette-port",
          "2828",
          "--tool-preset",
          "slim"
        ],
        "disabled": true
      }
    }
  },
  "permissions": [
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "/tmp", "effect": "allow" },
    { "action": "external_directory", "resource": "/tmp/**", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "rm", "effect": "ask" },
    { "action": "shell", "resource": "rm *", "effect": "ask" },
    { "action": "shell", "resource": "git clean *", "effect": "ask" },
    { "action": "shell", "resource": "git checkout *", "effect": "ask" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "ask" },
    { "action": "shell", "resource": "git restore *", "effect": "ask" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "chmod *", "effect": "ask" },
    { "action": "shell", "resource": "chown *", "effect": "ask" },
    { "action": "shell", "resource": "sudo *", "effect": "ask" },
    { "action": "shell", "resource": "mv *", "effect": "ask" },
    { "action": "shell", "resource": "kill *", "effect": "ask" },
    { "action": "shell", "resource": "pkill *", "effect": "ask" },
    { "action": "shell", "resource": "dd *", "effect": "ask" },
    { "action": "computeruse_*", "resource": "*", "effect": "ask" },
    { "action": "computeruse_get_app_state", "resource": "*", "effect": "ask" },
    { "action": "computeruse_perform_action", "resource": "*", "effect": "ask" },
    { "action": "computeruse_set_value", "resource": "*", "effect": "ask" }
  ],
  "agents": {
    "build": {
      "disabled": false
    },
    "plan": {
      "disabled": true
    },
    "explore": {
      "disabled": true
    },
    "general": {
      "disabled": true
    }
  }
}
