{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "oh-my-opencode-slim"
  ],
  "provider": {
    "gemini": {
      "name": "Gemini Gateway",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "{env:OPENAI_API_BASE}",
        "apiKey": "{env:OPENAI_API_KEY}"
      },
      "models": {
        "gemini-3.8-flash-high": {
          "name": "Gemini 3.8 Flash High"
        },
        "gemini-3-flash": {
          "name": "Gemini 3 Flash"
        }
      }
    },
    "openai": {
      "models": {
        "gpt-6-luna": {
          "name": "GPT-6 Luna",
          "variants": {
            "low": {
              "reasoningEffort": "low",
              "textVerbosity": "low"
            },
            "medium": {
              "reasoningEffort": "medium",
              "textVerbosity": "medium"
            },
            "high": {
              "reasoningEffort": "high",
              "textVerbosity": "medium"
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
              "textVerbosity": "high"
            }
          }
        },
        "gpt-6-astra": {
          "name": "GPT-6 Astra",
          "variants": {
            "low": {
              "reasoningEffort": "low",
              "textVerbosity": "low"
            },
            "medium": {
              "reasoningEffort": "medium",
              "textVerbosity": "medium"
            },
            "high": {
              "reasoningEffort": "high",
              "textVerbosity": "medium"
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
              "textVerbosity": "high"
            }
          },
          "attachment": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "gpt-6.1-sol": {
          "name": "GPT-6.1 Sol",
          "variants": {
            "low": {
              "reasoningEffort": "low",
              "textVerbosity": "low"
            },
            "medium": {
              "reasoningEffort": "medium",
              "textVerbosity": "medium"
            },
            "high": {
              "reasoningEffort": "high",
              "textVerbosity": "medium"
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
              "textVerbosity": "high"
            }
          }
        }
      },
      "npm": "@ai-sdk/openai",
      "options": {
        "baseURL": "{env:OPENAI_API_BASE}",
        "apiKey": "{env:OPENAI_API_KEY}"

      }
    }
  },
  "lsp": true,
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**"]
  },
  "mcp": {
    "servers": {
      "codegraph": {
        "type": "local",
        "command": [
          "codegraph",
          "serve",
          "--mcp"
        ],
        "disabled": false
      },
      "computeruse": {
        "type": "local",
        "command": [
          "bash",
          "{env:HOME}/.config/opencode/scripts/computer-use-linux.sh"
        ],
        "disabled": false
      },
      "firefox": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@mozilla/firefox-devtools-mcp@0.10.5",
          "--connect-existing",
          "--marionette-port",
          "2828",
          "--tool-preset",
          "slim"
        ],
        "disabled": true
      }
    }
  },
  "permission": {
    "read": "allow",
    "edit": "allow",
    "external_directory": {
      "*": "ask",
      "/tmp": "allow",
      "/tmp/**": "allow"
    },
    "bash": {
      "*": "allow",
      "rm": "ask",
      "rm *": "ask",
      "git clean *": "ask",
      "git checkout *": "ask",
      "git reset --hard *": "ask",
      "git restore *": "ask",
      "git push *": "ask",
      "chmod *": "ask",
      "chown *": "ask",
      "sudo *": "ask",
      "mv *": "ask",
      "kill *": "ask",
      "pkill *": "ask",
      "dd *": "ask"
    },
    "computeruse_*": "ask",
    "computeruse_get_app_state": "ask",
    "computeruse_perform_action": "ask",
    "computeruse_set_value": "ask"
  },
  "agent": {
    "build": {
      "disable": false
    },
    "plan": {
      "disable": true
    },
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  }
}
