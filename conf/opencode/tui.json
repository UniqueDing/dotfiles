{
  "$schema": "https://opencode.ai/tui.json",
  "theme": "catppuccin",
  "keybinds": {
    "leader": "ctrl+b",
    "command_list": "ctrl+x",
    "messages_page_up": "ctrl+u",
    "messages_page_down": "ctrl+d",
    "input_paste": "ctrl+v",
    "history_previous": [
      "up",
      "ctrl+p"
    ],
    "history_next": [
      "down",
      "ctrl+n"
    ]
  },
  "plugin": [
    "oh-my-openagent@4.19.2",
    "oh-my-opencode-slim"
  ]
}
