{
  "$schema": "https://unpkg.com/oh-my-opencode-slim@latest/oh-my-opencode-slim.schema.json",
  "companion": {
    "debug": false,
    "enabled": true,
    "gifPack": "default",
    "loopStyle": "classic",
    "position": "bottom-right",
    "size": "medium",
    "speed": 1
  },
  "multiplexer": {
    "layout": "main-vertical",
    "main_pane_size": 60,
    "type": "tmux"
  },
  "preset": "openai",
  "presets": {
    "openai": {
      "designer": {
        "mcps": [],
        "model": "openai/gpt-5.6-terra",
        "skills": [],
        "variant": "medium"
      },
      "explorer": {
        "mcps": [
          "codegraph"
        ],
        "model": "openai/gpt-5.6-luna",
        "skills": [],
        "variant": "low"
      },
      "fixer": {
        "mcps": [],
        "model": "openai/gpt-5.6-terra",
        "skills": [],
        "variant": "medium"
      },
      "librarian": {
        "mcps": [
          "websearch",
          "context7",
          "gh_grep"
        ],
        "model": "openai/gpt-5.6-luna",
        "skills": [],
        "variant": "low"
      },
      "oracle": {
        "mcps": [
          "codegraph"
        ],
        "model": "openai/gpt-5.6-sol",
        "skills": [
          "simplify"
        ],
        "variant": "xhigh"
      },
      "orchestrator": {
        "mcps": [
          "*",
          "!context7"
        ],
        "model": "openai/gpt-5.6-terra",
        "skills": [
          "*"
        ],
        "variant": "xhigh"
      }
    },
    "opencode-go": {
      "designer": {
        "mcps": [],
        "model": "opencode-go/kimi-k2.7-code",
        "skills": [],
        "variant": "medium"
      },
      "explorer": {
        "mcps": [],
        "model": "opencode-go/deepseek-v4-flash",
        "skills": [],
        "variant": "max"
      },
      "fixer": {
        "mcps": [],
        "model": "opencode-go/deepseek-v4-flash",
        "skills": [],
        "variant": "high"
      },
      "librarian": {
        "mcps": [
          "websearch",
          "context7",
          "gh_grep"
        ],
        "model": "opencode-go/deepseek-v4-flash",
        "skills": [],
        "variant": "high"
      },
      "observer": {
        "mcps": [],
        "model": "opencode-go/mimo-v2.5",
        "skills": [],
        "variant": "max"
      },
      "oracle": {
        "mcps": [],
        "model": "opencode-go/qwen3.7-max",
        "skills": [
          "simplify"
        ],
        "variant": "max"
      },
      "orchestrator": {
        "mcps": [
          "*",
          "!context7"
        ],
        "model": "opencode-go/minimax-m3",
        "skills": [
          "*"
        ],
        "variant": "max"
      }
    }
  }
}
