{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/2.67.0/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  "display": {
    "showErrors": false,
    "disableLinewrap": true,
    "size": {
      "ndigits": 0,
      "binaryPrefix": "jedec",
      "maxPrefix": "MB"
    },
    "temp": {
      "ndigits": 0
    },
    "key": {
      "type": "none"
    }
  },
  "modules": [
    {
      "type": "netio",
      "defaultRouteOnly": false,
      "namePrefix": "en",
      "format": "{rx-size} {tx-size}"
    },
    {
      "type": "cpuusage",
      "format": "{avg~0,-1}"
    },
    {
      "type": "memory",
      "format": "{percentage~0,-1}"
    },
    {
      "type": "cpu",
      "temp": true,
      "format": "{temperature~0,-3}"
    },
    {
      "type": "disk",
      "folders": "/",
      "format": "{size-percentage~0,-1}"
    },
    {
      "type": "datetime",
      "format": "{month-pretty}-{day-pretty} {hour-pretty}:{minute-pretty}"
    }
  ]
}
