default_shell "zsh"
default_mode "locked"
default_layout "right-main"
// Terminal-only workflow: do not start the Web server or permit sharing.
web_server false
web_sharing "disabled"
theme "catppuccin-mocha"
mouse_mode true
scroll_buffer_size 3000
scrollback_editor "nvim"
copy_on_select false
pane_frames false
show_startup_tips false
show_release_notes false

plugins {
    zjstatus location="https://github.com/dj95/zjstatus/releases/download/v0.24.0/zjstatus.wasm" {
        // Compact single-line footer: tabs/mode left, live metrics right.
        // Updated from the selected Zellij theme palette.
        color_bg "#111111"
        color_fg "#cdd6f4"
        color_black "#45475a"
        color_white "#bac2de"
        color_red "#f38ba8"
        color_yellow "#f9e2af"
        color_orange "#fab387"
        color_blue "#89b4fa"
        color_magenta "#cba6f7"
        color_cyan "#94e2d5"

        format_left "{tabs}"
        format_center "{mode}"
        format_right "{command_network}{command_cpuusage}{command_memory}{command_temperature}{command_disk}{command_clock}"
        format_precedence "crl"
        format_hide_on_overlength "true"
        tab_separator " "
        tab_truncate_start_format "←+{count} "
        tab_truncate_end_format " +{count}→"
        format_space "#[bg=$bg]"

        tab_normal "#[fg=$black,bg=$bg]#[fg=$white,bg=$black]{index} {name}#[fg=$black,bg=$bg]"
        tab_active "#[fg=$cyan,bg=$bg]#[fg=$black,bg=$cyan,bold]{index} {name}#[fg=$cyan,bg=$bg]"

        mode_locked ""
        mode_normal ""
        mode_scroll "#[fg=$orange,bg=$bg]#[fg=$bg,bg=$orange,bold] Scroll · Esc exit #[fg=$orange,bg=$bg] "
        mode_enter_search "#[fg=$yellow,bg=$bg]#[fg=$bg,bg=$yellow,bold] Search input · Enter confirm / Esc cancel #[fg=$yellow,bg=$bg] "
        mode_search "#[fg=$yellow,bg=$bg]#[fg=$bg,bg=$yellow,bold] Search · Esc exit #[fg=$yellow,bg=$bg] "
        mode_pane "#[fg=$red,bg=$bg]#[fg=$bg,bg=$red,bold] Close pane? Enter confirm / Esc cancel #[fg=$red,bg=$bg] "
        mode_tmux "#[fg=$magenta,bg=$bg]#[fg=$bg,bg=$magenta,bold] Command mode #[fg=$magenta,bg=$bg] "

        // Each command returns plain data; zjstatus owns all styling.
        command_network_command "sh -c 'fastfetch --config \"${XDG_CONFIG_HOME:-$HOME/.config}/zellij/fastfetch.jsonc\" --pipe true --structure netio | sed \"s| KB/s|K|g;s| MB/s|M|g;s| B/s|B|g\" | tr -d \"\\n\"'"
        command_network_format "#[fg=$blue,bg=$bg]#[fg=$black,bg=$blue]↓/↑ {stdout} "
        command_network_interval "1"
        command_network_hideonemptystdout "true"

        command_cpuusage_command "sh -c 'fastfetch --config \"${XDG_CONFIG_HOME:-$HOME/.config}/zellij/fastfetch.jsonc\" --pipe true --structure cpuusage | tr -d \"\\n\"'"
        command_cpuusage_format "#[fg=$yellow,bg=$blue]#[fg=$black,bg=$yellow] {stdout} "
        command_cpuusage_interval "1"
        command_cpuusage_hideonemptystdout "true"

        command_memory_command "sh -c 'fastfetch --config \"${XDG_CONFIG_HOME:-$HOME/.config}/zellij/fastfetch.jsonc\" --pipe true --structure memory | tr -d \"\\n\"'"
        command_memory_format "#[fg=$magenta,bg=$yellow]#[fg=$black,bg=$magenta] {stdout} "
        command_memory_interval "1"
        command_memory_hideonemptystdout "true"

        command_temperature_command "sh -c 'fastfetch --config \"${XDG_CONFIG_HOME:-$HOME/.config}/zellij/fastfetch.jsonc\" --pipe true --structure cpu | tr -d \"\\n\"'"
        command_temperature_format "#[fg=$orange,bg=$magenta]#[fg=$black,bg=$orange] {stdout} "
        command_temperature_interval "1"
        command_temperature_hideonemptystdout "true"

        command_disk_command "sh -c 'fastfetch --config \"${XDG_CONFIG_HOME:-$HOME/.config}/zellij/fastfetch.jsonc\" --pipe true --structure disk | tr -d \"\\n\"'"
        command_disk_format "#[fg=$cyan,bg=$orange]#[fg=$black,bg=$cyan]󰆓 {stdout} "
        command_disk_interval "1"
        command_disk_hideonemptystdout "true"

        command_clock_command "sh -c 'fastfetch --config \"${XDG_CONFIG_HOME:-$HOME/.config}/zellij/fastfetch.jsonc\" --pipe true --structure datetime | tr -d \"\\n\"'"
        command_clock_format "#[fg=$black,bg=$cyan]#[fg=$fg,bg=$black]{stdout}"
        command_clock_interval "1"
        command_clock_hideonemptystdout "true"

    }
    session-manager location="zellij:session-manager"
    about location="zellij:about"
    pane-mover location="https://github.com/timonwong/zellij-palette/releases/download/v0.2.2/zellij-palette.wasm" {
        palette "move-pane"
    }
}

keybinds clear-defaults=true {
    // Keep Ctrl shortcuts available to shells, editors and OpenCode.
    locked {
        bind "Ctrl g" { SwitchToMode "tmux"; }
    }
    tmux {
        // Positional indices, not stable pane slots.
        bind "q" { GoToTab 1; SwitchToMode "locked"; }
        bind "w" { GoToTab 2; SwitchToMode "locked"; }
        bind "f" { GoToTab 3; SwitchToMode "locked"; }
        bind "p" { GoToTab 4; SwitchToMode "locked"; }
        bind "g" { GoToTab 5; SwitchToMode "locked"; }
        bind "a" { GoToTab 6; SwitchToMode "locked"; }
        bind "r" { GoToTab 7; SwitchToMode "locked"; }
        bind "s" { GoToTab 8; SwitchToMode "locked"; }
        bind "t" { GoToTab 9; SwitchToMode "locked"; }
        bind "d" { GoToTab 10; SwitchToMode "locked"; }
        // Direct numbered joins are unavailable; R selects the destination instead.
        bind "Q" "W" "F" "P" "G" "A" "S" "T" { SwitchToMode "locked"; }
        bind "R" {
            LaunchOrFocusPlugin "pane-mover" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "locked"
        }
        bind ";" { SwitchToMode "renametab"; TabNameInput 0; }
        bind "h" { GoToPreviousTab; SwitchToMode "locked"; }
        bind "i" { GoToNextTab; SwitchToMode "locked"; }
        bind "e" { FocusPreviousPane; SwitchToMode "locked"; }
        bind "n" { FocusNextPane; SwitchToMode "locked"; }
        bind "j" { ToggleFocusFullscreen; SwitchToMode "locked"; }
        // Route ordinary splits into the left column, even after manual resizing dirties the swap layout.
        bind "k" { MoveFocus "Left"; NewPane; SwitchToMode "locked"; }
        bind "o" { NewTab { layout "right-main"; }; SwitchToMode "locked"; }
        // WezTerm forwards held RightCtrl+Shift+k/o/e/n as Ctrl-gK/O/E/N.
        bind "K" { NewPane "stacked"; SwitchToMode "locked"; }
        bind "O" { BreakPane; SwitchToMode "locked"; }
        bind "E" { PageScrollUp; SwitchToMode "scroll"; }
        bind "N" { PageScrollDown; SwitchToMode "scroll"; }
        // Move the divider left/right in normal 5% steps, independent of focused side.
        bind "l" { Resize "Increase Left"; SwitchToMode "locked"; }
        bind "u" { Resize "Increase Right"; SwitchToMode "locked"; }
        bind "m" { ToggleFloatingPanes; SwitchToMode "locked"; }
        // Prefix+x enters close confirmation: Enter closes; Esc cancels.
        bind "x" { SwitchToMode "pane"; }
        bind "b" { ToggleTab; SwitchToMode "locked"; }
        bind "c" "Alt c" { Copy; SwitchToMode "locked"; }
        bind "," { MovePaneBackwards; SwitchToMode "locked"; }
        bind "." { MovePane; SwitchToMode "locked"; }
        bind "y" "v" { SwitchToMode "scroll"; }
        bind "z" { NextSwapLayout; SwitchToMode "locked"; }
        bind "?" { LaunchOrFocusPlugin "about" { floating true; }; SwitchToMode "locked"; }
        bind "Enter" { LaunchOrFocusPlugin "session-manager" { floating true; }; SwitchToMode "locked"; }
        bind "Esc" { SwitchToMode "locked"; }
        bind "D" { Detach; }
        bind "Ctrl g" { Write 7; SwitchToMode "locked"; }
    }
    pane {
        bind "Enter" { CloseFocus; SwitchToMode "locked"; }
        bind "Esc" { SwitchToMode "locked"; }
    }
    renametab {
        bind "Enter" { SwitchToMode "locked"; }
        bind "Esc" "Ctrl c" { UndoRenameTab; SwitchToMode "locked"; }
    }
    shared_among "scroll" "search" {
        bind "e" "Up" { ScrollUp; }
        bind "n" "Down" { ScrollDown; }
        bind "h" "Left" { MoveFocus "Left"; }
        bind "i" "Right" { MoveFocus "Right"; }
        bind "E" "PageUp" "Ctrl b" { PageScrollUp; }
        bind "N" "PageDown" "Ctrl f" { PageScrollDown; }
        bind "u" { HalfPageScrollUp; }
        bind "d" { HalfPageScrollDown; }
        bind "/" "s" { SwitchToMode "entersearch"; SearchInput 0; }
        bind "Esc" "Ctrl c" "Ctrl s" { ScrollToBottom; SwitchToMode "locked"; }
        // Preserve the offset so repeated RightCtrl+Shift+e/n keep scrolling.
        bind "Ctrl g" { SwitchToMode "tmux"; }
    }
    entersearch {
        bind "Enter" { SwitchToMode "search"; }
        bind "Esc" "Ctrl c" { SwitchToMode "scroll"; }
        bind "Ctrl g" { SwitchToMode "tmux"; }
    }
    search {
        bind "k" { Search "down"; }
        bind "K" { Search "up"; }
        bind "c" { SearchToggleOption "CaseSensitivity"; }
        bind "w" { SearchToggleOption "Wrap"; }
        bind "o" { SearchToggleOption "WholeWord"; }
    }
}
