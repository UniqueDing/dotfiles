layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="zjstatus"
        }
    }

    tab {
        // Distinct startup identity keeps this pane pinned to the right.
        pane command="zsh" close_on_exit=true {
            args "-i"
        }
    }

    swap_tiled_layout name="right-main" {
        tab min_panes=2 {
            pane split_direction="vertical" {
                pane size="40%" split_direction="horizontal" { children; }
                pane size="60%" command="zsh" close_on_exit=true {
                    args "-i"
                }
            }
        }
    }
}
